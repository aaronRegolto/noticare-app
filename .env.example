# Copy this file to .env and fill in values from Supabase Project Settings > API Keys.
# Use a publishable (sb_publishable_...) or legacy anon key only; never add a secret/service_role key.
# Real Supabase login is required to sync with the admin dashboard.
EXPO_PUBLIC_ENABLE_DEV_PHONE_LOGIN=false
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key

# PayMongo (Pro billing via QRPh, a one-time payment) — see backend/supabase/README.md.
# Display-only prices; the amount actually charged comes from the
# PRICE_MONTHLY_CENTAVOS/PRICE_ANNUAL_CENTAVOS Supabase Function secrets.
EXPO_PUBLIC_PAYMONGO_PRICE_MONTHLY=₱149
EXPO_PUBLIC_PAYMONGO_PRICE_ANNUAL=₱999
