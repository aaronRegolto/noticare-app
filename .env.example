# Copy this file to .env and fill in values from Supabase Project Settings > API Keys.
# Use a publishable (sb_publishable_...) or legacy anon key only; never add a secret/service_role key.
# Real Supabase login is required to sync with the admin dashboard.
EXPO_PUBLIC_ENABLE_DEV_PHONE_LOGIN=false
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key
